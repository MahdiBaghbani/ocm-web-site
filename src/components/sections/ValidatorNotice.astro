---
import { isPageMounted } from "../../lib/sitePages";
import { normalizeValidatorContact } from "../validator/lib/validatorContact";

const contactRaw = import.meta.env.VALIDATOR_CONTACT;
const contactInput =
  typeof contactRaw === "string" ? contactRaw.trim() : String(contactRaw ?? "").trim();

if (isPageMounted("validator") && contactInput === "") {
  throw new Error("VALIDATOR_CONTACT is required when the validator page is mounted");
}

const contactLink =
  contactInput === "" ? null : normalizeValidatorContact(contactInput);

// Public start rate limit from opencloudmesh-go/internal/platform/config/presets.go
const startPublicRequests = 10;
const startPublicWindowSeconds = 60;
---

<aside
  class="space-y-3 rounded-2xl border border-amber-900/50 bg-amber-950/20 p-5 text-sm leading-6 text-amber-100/90"
  aria-label="Validator service notice"
>
  <h2 class="text-lg font-semibold text-amber-50">Public validator</h2>

  <p>Anyone can use this service. Rate limits and safe target rules apply.</p>

  <p>Results are informational and are not a certification.</p>

  <p>
    Saving a public report makes it available to anyone with the link.
  </p>

  <details class="rounded-xl border border-amber-900/40 bg-amber-950/30 p-3">
    <summary class="cursor-pointer font-medium text-amber-50">
      Service details
    </summary>

    <ul class="mt-3 list-disc space-y-2 pl-5">
      <li>
        Each client IP address can start up to {startPublicRequests} scans per {startPublicWindowSeconds} seconds.
      </li>
      <li>
        Private, loopback, link-local, metadata, and otherwise unsafe targets
        are blocked.
      </li>
      <li>
        Outbound validation requests do not carry browser cookies or user
        credentials, and redirects are re-checked before they are followed.
      </li>
      <li>Active validation may require interactive federation steps.</li>
      <li>Aggregate statistics apply the validator privacy threshold.</li>
      <li>Saved report availability follows the server retention policy.</li>
      <li>
        Operator contact:
        {contactLink?.ok === true && (
          <a
            class="text-sky-300 underline-offset-2 hover:text-sky-200 hover:underline"
            href={contactLink.href}
          >
            {contactLink.label}
          </a>
        )}
      </li>
    </ul>
  </details>
</aside>
