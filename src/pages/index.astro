---
import { isPageMounted, landing, pagePath } from '../lib/sitePages';
import HomepageLayout from '../layouts/HomepageLayout.astro';
import HeroSection from '../components/sections/HeroSection.astro';

if (!isPageMounted('home')) {
  const target = landing();
  return Astro.redirect(`${import.meta.env.BASE_URL}${pagePath(target)}`);
}
---

<HomepageLayout
  title="OpenCloudMesh"
  description="A server federation protocol that lets users share files, folders, and other resources across different cloud platforms."
>
  <HeroSection />
</HomepageLayout>
