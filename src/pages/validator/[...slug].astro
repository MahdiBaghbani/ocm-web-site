---
import InnerLayout from "../../layouts/InnerLayout.astro";
import ValidatorHero from "../../components/sections/ValidatorHero.astro";
import ValidatorNotice from "../../components/sections/ValidatorNotice.astro";
import ValidatorShell from "../../components/validator/islands/ValidatorShell.tsx";
import ResultsShell from "../../components/validator/islands/ResultsShell.tsx";
import StatisticsShell from "../../components/validator/islands/StatisticsShell.tsx";
import { isPageMounted, pagePath } from "../../lib/sitePages";

type ValidatorView = "index" | "results" | "statistics";

type ValidatorRouteProps = {
  view: ValidatorView;
};

export async function getStaticPaths() {
  const validatorMounted = isPageMounted("validator");
  const statisticsMounted = isPageMounted("statistics");

  if (!validatorMounted && !statisticsMounted) {
    return [];
  }

  const paths: Array<{
    params: { slug: string | undefined };
    props: ValidatorRouteProps;
  }> = [];

  paths.push({ params: { slug: undefined }, props: { view: "index" } });

  if (validatorMounted) {
    paths.push({ params: { slug: "results" }, props: { view: "results" } });
  }

  if (statisticsMounted) {
    paths.push({
      params: { slug: "statistics" },
      props: { view: "statistics" },
    });
  }

  return paths;
}

const { view } = Astro.props as ValidatorRouteProps;
const base = import.meta.env.BASE_URL;
const validatorMounted = isPageMounted("validator");
const statisticsMounted = isPageMounted("statistics");
const resultsHref = `${base}${pagePath("validator")}results/`;
const statisticsHref = `${base}${pagePath("statistics")}`;
const validatorHref = `${base}${pagePath("validator")}`;
---

{view === "index" && validatorMounted && (
  <InnerLayout
    title="OCM Validator"
    description="OCM compatibility validator for remote hosts."
  >
    <main class="space-y-6">
      <ValidatorHero />
      {statisticsMounted && (
        <nav>
          <a
            class="inline-flex rounded-xl border border-gray-800 bg-gray-900/40 px-3 py-2 text-sm text-gray-200 hover:bg-gray-900"
            href={statisticsHref}
          >
            View statistics
          </a>
        </nav>
      )}
      <ValidatorShell client:load resultsHref={resultsHref} />
      <ValidatorNotice />
    </main>
  </InnerLayout>
)}

{view === "index" && !validatorMounted && statisticsMounted && (
  <InnerLayout
    title="OCM Validator"
    description="OCM compatibility validator statistics hub."
  >
    <main class="space-y-6">
      <header class="space-y-2">
        <h1 class="text-2xl font-semibold text-white md:text-3xl">
          OCM Validator Statistics
        </h1>
        <p class="text-sm text-gray-300">
          Validator scans are not enabled on this site profile. Open the
          statistics view for aggregate pass rates and grade distribution.
        </p>
      </header>
      <nav>
        <a
          class="inline-flex rounded-xl border border-gray-800 bg-gray-900/40 px-3 py-2 text-sm text-gray-200 hover:bg-gray-900"
          href={statisticsHref}
        >
          View statistics
        </a>
      </nav>
    </main>
  </InnerLayout>
)}

{view === "results" && (
  <InnerLayout
    title="Validator Results - OCM Validator"
    description="OCM compatibility validator results."
  >
    <main class="space-y-6">
      <header class="space-y-2">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h1 class="text-2xl font-semibold text-white md:text-3xl">
            Validator Results
          </h1>
          <a
            class="rounded-xl border border-gray-800 bg-gray-900/40 px-3 py-2 text-sm text-gray-200 hover:bg-gray-900"
            href={validatorHref}
          >
            Back to validator
          </a>
        </div>
        <p class="text-sm text-gray-300">
          Live session status, manifest summary, and report evidence.
        </p>
      </header>

      <ResultsShell client:load />
    </main>
  </InnerLayout>
)}

{view === "statistics" && (
  <InnerLayout
    title="Validator Statistics - OCM Validator"
    description="OCM compatibility validator statistics."
  >
    <main class="space-y-6">
      <header class="space-y-2">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h1 class="text-2xl font-semibold text-white md:text-3xl">
            Validator Statistics
          </h1>
          <a
            class="rounded-xl border border-gray-800 bg-gray-900/40 px-3 py-2 text-sm text-gray-200 hover:bg-gray-900"
            href={validatorHref}
          >
            Back to validator
          </a>
        </div>
        <p class="text-sm text-gray-300">
          Aggregate pass rates and grade distribution from opted-in scans.
        </p>
      </header>

      <StatisticsShell client:load />
    </main>
  </InnerLayout>
)}
